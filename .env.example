# ==========================================
# Hotel Kiosk Backend-Local Environment Variables
# ==========================================

# Server Configuration
PORT=5000

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Staff Kiosk Admin Override PIN (Default is '1234' if omitted)
STAFF_KIOSK_PIN=1234

# OCR Provider Configuration (options: 'tesseract', 'google', 'azure')
# Defaults to built-in local 'tesseract' engine if cloud keys are omitted
OCR_PROVIDER=tesseract

# Google Cloud Vision OCR (Optional - when OCR_PROVIDER=google)
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key

# Azure AI Document Intelligence (Optional - when OCR_PROVIDER=azure)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_doc_intelligence_key

# Document Authenticity Verification Providers (Optional)
# If unconfigured, system safely defaults to 'pending_manual_review'
# Passports (ICAO PKD / Border verification API)
ICAO_PKD_SERVICE_URL=
PASSPORT_VERIFY_API_KEY=

# UIDAI Aadhaar Verification (Official UIDAI Authorized Gateway)
UIDAI_VERIFY_ENDPOINT=
UIDAI_AUTH_API_KEY=
UIDAI_PUBLIC_CERT_PATH=

# Driver's License Authority (AAMVA for US/Canada, Parivahan for India)
AAMVA_VERIFY_API_KEY=
PARIVAHAN_VERIFY_API_KEY=

# PAN Card (Income Tax Department / NSDL)
NSDL_PAN_VERIFY_API_KEY=
