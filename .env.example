# ==========================================
# Hotel Kiosk Backend - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Staff Authentication (Stored securely in PostgreSQL 'staff' table with bcrypt hashes)
# Run `npm run seed:staff` to populate demo accounts or execute migration 20261014_staff_and_id_verification.sql.
# Demo Staff Credentials for Local Development:
# - STAFF-101 (Role: front_desk, PIN: 1234)
# - STAFF-102 (Role: manager, PIN: 5678)
# - STAFF-103 (Role: admin, PIN: 9999)

# OCR Provider Configuration (options: 'tesseract', 'google', 'azure')
# Defaults to built-in local 'tesseract' engine (no cloud credentials required)
OCR_PROVIDER=tesseract

# Google Cloud Vision OCR (Optional - used when OCR_PROVIDER=google)
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key

# Azure AI Document Intelligence (Optional - used when OCR_PROVIDER=azure)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_doc_intelligence_key

# Document Authenticity Verification Providers (Optional - Government & PKI Gateways)
# When gateways are unconfigured, system safely defaults to 'pending_manual_review' for staff physical inspection.
# Passports (ICAO PKD / Border verification API)
ICAO_PKD_SERVICE_URL=
PASSPORT_VERIFY_API_KEY=

# UIDAI Aadhaar Verification (Official UIDAI Authorized Gateway)
UIDAI_VERIFY_ENDPOINT=
UIDAI_AUTH_API_KEY=
UIDAI_PUBLIC_CERT_PATH=

# Driver's License Authority (AAMVA for US/Canada, Parivahan for India)
AAMVA_VERIFY_API_KEY=
PARIVAHAN_VERIFY_API_KEY=

# PAN Card (Income Tax Department / NSDL)
NSDL_PAN_VERIFY_API_KEY=
